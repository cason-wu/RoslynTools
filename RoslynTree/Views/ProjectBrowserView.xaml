<UserControl x:Class="RoslynTree.Views.ProjectBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RoslynTree.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <TextBlock Margin="8,4" FontWeight="SemiBold" Text="Project Browser"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </Border>

        <!-- Project / Namespace / Type tree -->
        <TreeView Grid.Row="1" x:Name="BrowserTree"
                  ItemsSource="{Binding NamespaceNodes}"
                  BorderThickness="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <TreeView.Resources>
                <!-- Namespace node -->
                <HierarchicalDataTemplate DataType="{x:Type vm:NodeNamespaceViewModel}"
                                          ItemsSource="{Binding Types}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon, Converter={StaticResource ImageMonikerToImageSourceConverter}}"
                               Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                        <TextBlock Margin="6,0,0,0"
                                   Text="{Binding SummaryText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Type node — expands to show members -->
                <HierarchicalDataTemplate DataType="{x:Type vm:NodeTypeViewModel}"
                                          ItemsSource="{Binding Members}">
                    <StackPanel Orientation="Horizontal"
                                ToolTip="{Binding TipText}">
                        <Image Source="{Binding Icon, Converter={StaticResource ImageMonikerToImageSourceConverter}}"
                               Width="16" Height="16" Margin="0,0,4,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <TextBlock Text="{Binding MetadataText}" FontSize="10"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </StackPanel>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <!-- Member leaf (method / property / field / event) -->
                <DataTemplate DataType="{x:Type vm:NodeMemberViewModel}">
                    <StackPanel Orientation="Horizontal" Margin="0,1"
                                ToolTip="{Binding TipText}">
                        <Image Source="{Binding Icon, Converter={StaticResource ImageMonikerToImageSourceConverter}}"
                               Width="16" Height="16" Margin="0,0,4,0"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="11"
                                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                <TextBlock Text="{Binding TypeName, StringFormat=' : {0}'}" FontSize="10"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MetadataText}" FontSize="10"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>

            <!-- Allow clicking leaf nodes to fire SelectEntryCommand -->
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                    <EventSetter Event="MouseLeftButtonUp" Handler="TreeViewItem_MouseLeftButtonUp"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
