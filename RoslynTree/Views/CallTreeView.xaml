<UserControl x:Class="RoslynTree.Views.CallTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RoslynTree.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tree -->
        <TreeView Grid.Row="0"
                  ItemsSource="{Binding Roots}"
                  BorderThickness="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:CallTreeNodeViewModel}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="1">
                        <Image Source="{Binding Icon, Converter={StaticResource ImageMonikerToImageSourceConverter}}"
                               Width="16" Height="16" Margin="0,0,4,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Foreground="#0078D4" FontSize="10"
                                       Text="{Binding MetadataText}"/>
                            <TextBlock Foreground="Gray" FontSize="10"
                                       Text="{Binding SourceDisplay}"/>
                        </StackPanel>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <!-- Status / busy -->
        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <ProgressBar Width="100" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
